# Automatically treat detected text files as text
* text=auto

# Source code and configuration files use Unix line endings
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env text eol=lf

# Windows PowerShell files use Windows line endings
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
*.xlsx binary
*.docx binary

# Power BI project files follow Desktop line endings; UTF-8 without BOM
*.tmdl text eol=crlf
*.pbip text eol=crlf
*.pbir text eol=crlf
*.pbism text eol=crlf
powerbi/**/*.json text eol=crlf
*.pbix binary
*.abf binary
*.parquet binary
