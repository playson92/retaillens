# Connection from a host process or Power BI Desktop.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=retaillens
DATABASE_USER=retaillens_app
DATABASE_PASSWORD=change_me

# A containerized client uses the Compose database service and its internal port.
# setup.ps1 generates private credentials when .env is absent.
# Never embed credentials in PBIP, Git, logs or review reports.
# Select real/synthetic explicitly using the CLI --mode or demo.ps1 -Mode.
