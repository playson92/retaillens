{
  "tables": {
    "Orders": {
      "source": "mart_orders",
      "columns": {
        "order_id": "string",
        "purchase_date": "dateTime",
        "order_status": "string",
        "customer_unique_id": "string",
        "customer_state": "string",
        "item_value": "decimal",
        "expected_amount": "decimal",
        "paid_amount": "decimal",
        "payment_delta": "decimal",
        "gmv_eligible": "boolean",
        "delivery_eligible": "boolean",
        "is_on_time": "boolean",
        "delay_days": "int64",
        "review_score": "int64",
        "review_ambiguous": "boolean",
        "item_count": "int64",
        "seller_count": "int64",
        "single_seller_id": "string",
        "reconciliation_status": "string",
        "purchase_timestamp": "dateTime",
        "missing_price_count": "int64",
        "missing_freight_count": "int64",
        "missing_payment_count": "int64",
        "review_count": "int64",
        "reviewed_eligible": "boolean"
      }
    },
    "Items": {
      "source": "mart_items",
      "columns": {
        "order_id": "string",
        "order_item_id": "int64",
        "purchase_date": "dateTime",
        "product_id": "string",
        "seller_id": "string",
        "price": "decimal",
        "freight_value": "decimal",
        "gmv_eligible": "boolean"
      }
    },
    "Date": {
      "source": "dim_date",
      "columns": {
        "date": "dateTime",
        "year": "int64",
        "month": "int64",
        "year_month": "string",
        "is_boundary_month": "boolean"
      }
    },
    "Product": {
      "source": "dim_product",
      "columns": {
        "product_id": "string",
        "category": "string"
      }
    },
    "Seller": {
      "source": "dim_seller",
      "columns": {
        "seller_id": "string",
        "seller_state": "string"
      }
    },
    "Cohorts": {
      "source": "mart_cohorts",
      "columns": {
        "customer_unique_id": "string",
        "first_purchase_date": "dateTime",
        "eligible_90d": "boolean",
        "repeated_90d": "boolean",
        "first_purchase_timestamp": "dateTime",
        "same_timestamp_orders": "int64"
      }
    },
    "Quality": {
      "source": "quality_summary",
      "columns": {
        "check_name": "string",
        "severity": "string",
        "affected_rows": "int64",
        "details": "string"
      }
    },
    "Run": {
      "source": "run_metadata",
      "columns": {
        "data_mode": "string",
        "source_version": "string",
        "analysis_start": "dateTime",
        "analysis_end_exclusive": "dateTime",
        "observation_end": "dateTime",
        "observation_basis": "string",
        "imported_at": "dateTime",
        "reconciliation_tolerance": "string",
        "source_manifest_sha256": "string"
      }
    }
